# 本机环境与依赖：绝不上架
.venv/
venv/
__pycache__/
*.py[cod]
tools/pythons/
tools/uv-cache/
bin/
cache/

# 两个上游引擎的源码由用户自己取（见 docs/DEPLOY.md），本仓库不重新发布
vendor/
MaiBot-main/
MaiBot-Napcat-Adapter-main/
*.zip

# 凭据与运行数据：任何一条都不该进 git
secrets/
astrmai_state/
*.credentials.json
credentials.json
model_credentials.json
.env
data/
e2e/
probe/
dist/
*.log
*.db
*.sqlite3
