{
  "manifest_version": 2,
  "version": "0.1.0",
  "name": "AstrBot 工具桥（astrbot_bridge）",
  "description": "让麦麦这一侧也能用 AstrBot 的插件工具：连一个跑着 astrmai 控制台的 AstrBot 实例，列出它的工具/命令并按需调用。不嵌 AstrBot、不双开连接，跨进程 HTTP。",
  "author": {
    "name": "astrmai",
    "url": "https://github.com/lango578"
  },
  "license": "AGPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/lango578/astrmai",
    "homepage": "https://github.com/lango578/astrmai",
    "documentation": "https://github.com/lango578/astrmai/blob/main/docs/DEPLOY.md",
    "issues": "https://github.com/lango578/astrmai/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    }
  ],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "puzzle",
      "background": "#141419"
    }
  },
  "capabilities": [
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "astrmai.astrbot-bridge"
}
